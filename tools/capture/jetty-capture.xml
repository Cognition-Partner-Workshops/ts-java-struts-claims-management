<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC
    "-//Mort Bay Consulting//DTD Configure//EN"
    "http://www.eclipse.org/jetty/configure_9_0.dtd">
<!--
  Capture-only context configuration, selected by tools/capture/capture.py with
  -Dclaims.jetty.contextXml. It binds the same resources as
  WEB-INF/jetty-env.xml and also serves the application's file database over
  the HSQLDB network protocol so the harness can snapshot it while Jetty holds
  the file lock. org.hsqldb is loaded from the plugin class loader for the
  webapp too, so the in-process file: connections opened by the DAOs and this
  server share one open database instead of competing for the lock.
-->
<Configure
    id="wac"
    class="org.eclipse.jetty.webapp.WebAppContext">
    <Call name="addSystemClass">
        <Arg>org.hsqldb.</Arg>
    </Call>
    <New
        id="claimsDb"
        class="org.eclipse.jetty.plus.jndi.Resource">
        <Arg>
            <Ref refid="wac" />
        </Arg>
        <Arg>jdbc/ClaimsDB</Arg>
        <Arg>
            <New class="org.hsqldb.jdbc.JDBCDataSource">
                <Set name="Database">
                    jdbc:hsqldb:file:${java.io.tmpdir}/northstar-claims-db
                </Set>
                <Set name="User">SA</Set>
            </New>
        </Arg>
    </New>
    <New
        id="captureDbServer"
        class="org.hsqldb.server.Server">
        <Set name="Address"><SystemProperty name="claims.capture.db.address" default="127.0.0.1" /></Set>
        <Set name="Port"><SystemProperty name="claims.capture.db.port" default="9001" /></Set>
        <Set name="Silent">true</Set>
        <Set name="Trace">false</Set>
        <Set name="NoSystemExit">true</Set>
        <Call name="setDatabaseName">
            <Arg type="int">0</Arg>
            <Arg>northstar</Arg>
        </Call>
        <Call name="setDatabasePath">
            <Arg type="int">0</Arg>
            <Arg>file:<SystemProperty name="claims.db.path" default="target/db/northstar" /></Arg>
        </Call>
        <Call name="start" />
    </New>
</Configure>
